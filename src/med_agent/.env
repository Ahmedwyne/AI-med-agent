# ── Required ──────────────────────────────────────────────
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Groq LLM tuning (sensible defaults, change if needed) ─
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_MAX_RETRIES=5
GROQ_RETRY_DELAY=10.0
GROQ_RATE_LIMIT_TPM=12000

# ── Embedding & vector store ───────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_DIR=med_agent/vector_store

# ── PubMed (optional — higher rate limit with a key) ──────
# Register free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
PUBMED_RETMAX=5

# ── Drug API (optional) ────────────────────────────────────
DRUG_API_KEY=

# ── Legacy placeholders (not actively used by current code) ─
OPENAI_API_KEY=
PUBMED_API_KEY=
RXNORM_API_KEY=
CLINICAL_TRIALS_API_KEY=
